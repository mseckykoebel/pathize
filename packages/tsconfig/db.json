{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "db",
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "commonjs",
    "target": "esnext",
    "strictFunctionTypes": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "isolatedModules": true,
    "incremental": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "sourceMap": true
  }
}
