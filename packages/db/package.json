{
  "name": "@pathize/db",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "ts-node --transpile-only ./scripts/setup.ts",
    "build": "rm -rf dist && yarn generate && tsc",
    "generate": "rm -rf generated && yarn prisma generate",
    "db:push": "yarn prisma db push",
    "db:seed": "yarn prisma db seed",
    "postinstall": "yarn generate",
    "lint": "eslint index.ts"
  },
  "devDependencies": {
    "@types/eslint": "^8",
    "@types/node": "^20.2.5",
    "eslint-config-custom": "workspace:*",
    "nodemon": "^3.1.0",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "prisma": "5.10.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@prisma/client": "5.10.2",
    "dotenv": "^16.1.3",
    "eslint": "^8.32.0",
    "jose": "^4.13.1"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  }
}
