{
  "name": "@pathize/web-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "eslint": "7.32.0",
    "eslint-config-custom": "workspace:*",
    "react": "^18.2.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-common-types": "*",
    "@fortawesome/react-native-fontawesome": "*",
    "@heroicons/react": "*",
    "@tremor/react": "*",
    "@types/react": "*",
    "react": "*",
    "tailwindcss": "*"
  }
}
