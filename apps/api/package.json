{
  "name": "@pathize/api",
  "version": "0.0.1",
  "author": "Pathize",
  "license": "ISC",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "setup": "ts-node --transpile-only ./scripts/setup.ts",
    "build": "tsc -p tsconfig.json && copyfiles -u 1 \"./ask/resources/**/*.*\" ./dist/ask && copyfiles -u 1 \"./ask/prompts/**/*.*\" ./dist/ask",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon index.ts",
    "test": "jest --coverage",
    "lint": "eslint ."
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    }
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/request-context": "^5.0.0",
    "@fastify/websocket": "^9.0.0",
    "@notionhq/client": "^2.2.13",
    "@pathize/db": "workspace:*",
    "@pathize/lib": "workspace:*",
    "customerio-node": "^4.1.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "dayjs": "^1.11.7",
    "dotenv": "^16.1.3",
    "fastify": "^4.24.3",
    "fastify-cron": "^1.3.1",
    "firebase-admin": "^12.0.0",
    "jose": "^4.13.1",
    "openai": "^4.29.1",
    "posthog-node": "^3.6.3",
    "terra-api": "1.4.5"
  },
  "devDependencies": {
    "@types/copyfiles": "^2",
    "@types/jest": "^29.5.6",
    "@types/mysql": "^2",
    "@types/node": "^20.2.5",
    "@types/ws": "^8.5.9",
    "copyfiles": "^2.4.1",
    "eslint": "7.32.0",
    "eslint-config-custom": "workspace:*",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig": "workspace:*",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
